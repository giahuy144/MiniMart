    {
      "name": "Register - Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registeredUsername}}\",\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"{{registeredEmail}}\",\n  \"phoneNumber\": \"0901234567\",\n  \"password\": \"{{registeredPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const username = 'pm' + Date.now();",
              "pm.collectionVariables.set('registeredUsername', username);",
              "pm.collectionVariables.set('registeredEmail', username + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer account created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('registeredUserId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - Registered User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{registeredEmail}}\",\"password\":\"{{registeredPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registered user can login', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.data.token);",
              "pm.collectionVariables.set('userId', body.data.userId);",
              "pm.collectionVariables.set('currentPassword', pm.collectionVariables.get('registeredPassword'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Get Users - Admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/users",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can list users', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const target = body.data.find(user => user.id === pm.collectionVariables.get('registeredUserId'));",
              "if (target) pm.collectionVariables.set('targetUserId', target.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\":\"Postman Updated User\",\"phoneNumber\":\"0912345678\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/profile",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Change Password",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"oldPassword\":\"{{currentPassword}}\",\"newPassword\":\"{{newPassword}}\",\"confirmPassword\":\"{{newPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/change-password",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Password changed', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('currentPassword', pm.collectionVariables.get('newPassword'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Toggle User Status - Admin",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/auth/users/{{targetUserId}}/toggle-status",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}