{
  "info": {
    "_postman_id": "b44b2f95-6c54-4a3b-9445-3a1789f85fb2",
    "name": "MiniMart AuthService - Week 2",
    "description": "AuthService requests for the MiniMart team. Seed logins are included for all four roles. Register creates a Customer; run Login - Registered User before profile/password requests. Admin token is saved separately for Get Users and account status toggle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "registeredUserId",
      "value": ""
    },
    {
      "key": "registeredUsername",
      "value": ""
    },
    {
      "key": "registeredEmail",
      "value": ""
    },
    {
      "key": "registeredPassword",
      "value": "MiniMart123!"
    },
    {
      "key": "currentPassword",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": "MiniMart456!"
    }
  ],
  "item": [
    {
      "name": "Login - Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@minimart.vn\",\n  \"password\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.data.token);",
              "pm.collectionVariables.set('userId', body.data.userId);",
              "pm.collectionVariables.set('currentPassword', 'admin123');",
              "pm.collectionVariables.set('adminToken', body.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - Cashier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cashier@minimart.vn\",\n  \"password\": \"cashier123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.data.token);",
              "pm.collectionVariables.set('userId', body.data.userId);",
              "pm.collectionVariables.set('currentPassword', 'cashier123');",
              "pm.test('Role matches seeded account', function () { pm.expect(body.data.role).to.eql('Cashier'); });"
            ]
          }
        }
      ]
    },
